<mxfile host="app.diagrams.net"><diagram name="ML Pipeline" id="ml-pipeline"><mxGraphModel dx="1300" dy="1530" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1530" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="E1" value="&lt;b&gt;E1: Hotel Booking Datasets&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;b&gt;(2015–2017, 2017–2018)&lt;/b&gt;&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8131A;strokeColor=#B00D12;fontColor=#FFFFFF;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="470.0" y="25.0" width="340" height="74" as="geometry"/></mxCell><mxCell id="KEY" value="&lt;b&gt;KEY&lt;/b&gt;&lt;br&gt;&lt;b&gt;E = External Entities&lt;br&gt;P = Processes&lt;br&gt;D = Data Stores&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#6FA8FF;strokeColor=#3D5AFE;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1015.0" y="12.0" width="210" height="100" as="geometry"/></mxCell><mxCell id="P1" value="&lt;b&gt;P1: Harmonise &amp;amp; Merge&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;b&gt;(Translate categories, align&lt;br&gt;columns, add guest IDs)&lt;/b&gt;&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1673E6;strokeColor=#0F57B3;fontColor=#FFFFFF;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60.0" y="184.0" width="280" height="92" as="geometry"/></mxCell><mxCell id="D1" value="&lt;b&gt;D1: Unified Dataset&lt;/b&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#FCCB13;strokeColor=#C99A00;fontColor=#000000;fontFamily=Times New Roman;fontSize=15;" vertex="1" parent="1"><mxGeometry x="510.0" y="184.0" width="260" height="92" as="geometry"/></mxCell><mxCell id="P2" value="&lt;b&gt;P2: Data Preprocessing&lt;/b&gt;&lt;br&gt;&lt;i&gt;&lt;b&gt;(Clean, Cap Outliers,&lt;br&gt;Convert to KSh, Encode)&lt;